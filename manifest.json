{
  "manifest_version": 3,
  "name": "Depop Bag Calculator",
  "version": "2.0.0",
  "description": "Scan visible Depop bag items and calculate an estimated total directly in the extension.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.depop.com/*"],
  "action": {
    "default_icon": {
      "16": "icons/depop_bag_calculator_icon.png",
      "48": "icons/depop_bag_calculator_icon.png",
      "128": "icons/depop_bag_calculator_icon.png"
    },
    "default_popup": "popup.html",
    "default_title": "Depop Bag Calculator"
  },
  "icons": {
    "16": "icons/depop_bag_calculator_icon.png",
    "48": "icons/depop_bag_calculator_icon.png",
    "128": "icons/depop_bag_calculator_icon.png"
  }
}
